DJANGO_SECRET_KEY=your-secret-key-here
DATABASE_URL=postgres://username:password@localhost:5432/your_db_name
DJANGO_DEBUG=True
# Use "localhost" for local dev. "127.0.0.1" won't match ALLOWED_HOSTS unless added manually,
# though dev settings already override ALLOWED_HOSTS to ['*'] so either works in practice.
DOMAIN=localhost